{
  "name": "agent-approval-gateway",
  "version": "0.1.0",
  "description": "Human sign-off for AI agent actions: HMAC-signed approval cards, exactly-once execution, a durable job queue and a tamper-evident audit log.",
  "type": "module",
  "license": "MIT",
  "author": "Idris-Michael Bakare",
  "repository": "github:Idris-Michael/agent-approval-gateway",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "demo": "tsx examples/lender-demo.ts",
    "agent": "tsx examples/agent-call.ts",
    "start": "node dist/examples/lender-demo.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
