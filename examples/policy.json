{
  "version": 1,
  "defaults": { "expiryHours": 72 },
  "approverGroups": {
    "finance-lead": ["env:FINANCE_APPROVER_ID"],
    "ops-lead": ["env:OPS_APPROVER_ID"]
  },
  "tools": {
    "lookup_customer": { "requiresApproval": false },
    "lookup_transactions": { "requiresApproval": false },
    "issue_refund": { "requiresApproval": true, "approvers": ["finance-lead"], "expiryHours": 24 },
    "send_invoice": { "requiresApproval": true, "approvers": ["finance-lead", "ops-lead"] }
  }
}
